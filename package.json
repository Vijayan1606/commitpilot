{
  "name": "commitpilot-ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Conversational repository analysis and review assistant for Alan AI, powered by open models.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "mcp": "tsx src/mcp/http.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:setup": "node scripts/setup-demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "audit": "node scripts/audit.mjs",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "express": "^4.21.2",
    "next": "^15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
