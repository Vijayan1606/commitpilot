# ---------------------------------------------------------------------------
# CommitPilot AI configuration (placeholders only — never commit real secrets)
# Copy to .env.local for the web app, and to .env for the MCP server.
# ---------------------------------------------------------------------------

# Absolute or project-relative directory that may contain registered Git repos.
# Path validation is enforced against this root for every filesystem operation.
COMMITPILOT_WORKSPACE_ROOT=./.workspaces

# Where the SQLite database and local encryption key live.
COMMITPILOT_DATA_DIR=./.data

# Optional absolute path override for the SQLite file.
# COMMITPILOT_DB_PATH=./.data/commitpilot.db

# ---------------------------------------------------------------------------
# Open model (OpenAI-compatible chat completions endpoint)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint serving an open-weights model works.
# Local, no API key, no GPU required (Ollama example):
#   OPENMODEL_BASE_URL=http://127.0.0.1:11434/v1
#   OPENMODEL_MODEL=qwen2.5-coder:7b-instruct
# Hosted example (set the key in the Settings UI or here):
#   OPENMODEL_BASE_URL=https://openrouter.ai/api/v1
#   OPENMODEL_MODEL=qwen/qwen3-coder:free
OPENMODEL_BASE_URL=
OPENMODEL_MODEL=
OPENMODEL_API_KEY=
OPENMODEL_TIMEOUT_MS=120000
OPENMODEL_MAX_RETRIES=1
OPENMODEL_MAX_CONTEXT_CHARS=120000
OPENMODEL_JSON_MODE=true

# ---------------------------------------------------------------------------
# Safety and limits
# ---------------------------------------------------------------------------
# Patch application is disabled unless explicitly enabled here AND approved
# per patch in the UI / tool call.
COMMITPILOT_ALLOW_PATCH_APPLY=false
# Validation commands are disabled unless enabled; every run still needs an
# explicit allowlisted command id.
COMMITPILOT_ALLOW_COMMANDS=false
COMMITPILOT_MAX_FILES=2000
COMMITPILOT_MAX_FILE_BYTES=262144
COMMITPILOT_MAX_DIFF_BYTES=200000

# ---------------------------------------------------------------------------
# Alan AI MCP connector
# ---------------------------------------------------------------------------
# Bearer token that Alan's custom MCP connector must present.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMMITPILOT_MCP_TOKEN=
COMMITPILOT_MCP_HOST=127.0.0.1
COMMITPILOT_MCP_PORT=4319
# Public base URL used only for display/instructions (e.g. an HTTPS tunnel).
COMMITPILOT_PUBLIC_URL=

# Extra secret material for the local AES-256-GCM key (optional; a local key
# file is generated under COMMITPILOT_DATA_DIR when unset).
# COMMITPILOT_APP_SECRET=
